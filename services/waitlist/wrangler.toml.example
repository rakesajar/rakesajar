# Copy to wrangler.toml, fill in ids, add secrets (HMAC_KEY, CONFIRM_WEBHOOK_TOKEN, TURNSTILE_SECRET), then deploy.
name = "pathfinder-waitlist"
main = "worker.ts"
compatibility_date = "2026-11-01"

[[kv_namespaces]]
binding = "WAITLIST"
id = "REPLACE_WITH_KV_NAMESPACE_ID"

[[unsafe.bindings]]
name = "RATE_LIMITER"
type = "ratelimit"
namespace_id = "1001"
simple = { limit = 5, period = 60 }

[vars]
ALLOWED_ORIGIN = "https://pathfinder.example"
PUBLIC_BASE = "https://pathfinder-waitlist.example.workers.dev"
DESTINATIONS = "australia,canada,france,germany,ireland,japan,new-zealand,singapore,uae,uk,usa"
CONFIRM_WEBHOOK = "https://REPLACE_WITH_YOUR_SENDER"
RETENTION_DAYS = "365"
