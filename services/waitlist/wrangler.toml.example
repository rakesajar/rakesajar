# Copy to wrangler.toml, create the KV namespace, then `npx wrangler deploy`.
name = "pathfinder-waitlist"
main = "worker.ts"
compatibility_date = "2026-11-01"

[[kv_namespaces]]
binding = "WAITLIST"
id = "REPLACE_WITH_KV_NAMESPACE_ID"

[vars]
ALLOWED_ORIGIN = "https://pathfinder.example"
DESTINATIONS = "australia,canada,france,germany,ireland,japan,new-zealand,singapore,uae,uk,usa"
RETENTION_DAYS = "365"
