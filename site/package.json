{
  "name": "pathfinder-site",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-figures.mjs",
    "preview": "astro preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node tests/e2e/run.mjs",
    "lint": "astro check && eslint . --max-warnings 0 && prettier --check \"src/**/*.{ts,css,mjs}\" \"tests/**/*.{ts,mjs}\" \"scripts/**/*.mjs\"",
    "check:sources": "node scripts/check-sources.mjs",
    "verify:passages": "node scripts/verify-passages.mjs",
    "verify:passages:stamp": "node scripts/verify-passages.mjs --stamp"
  },
  "dependencies": {
    "astro": "7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "axe-core": "4.14.1",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-security": "4.2.1",
    "node-html-parser": "9.0.7",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
