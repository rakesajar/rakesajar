---
import type { Destination } from '../data/destinations';
import type { Fact } from '../data/types';
import { appliesOn, freshAttrs, presentation } from '../lib/facts';
import ViewFlags from './ViewFlags.astro';

interface Props {
  destination: Destination;
  facts: Fact[];
  today: string;
}
const { destination: d, facts, today } = Astro.props;
const pick = (topic: Fact['topic']) =>
  facts.find((f) => f.destination === d.slug && f.topic === topic && appliesOn(f, today) && presentation(f, today) === 'current');
const rows = [
  { k: 'Study on', f: pick('permission') },
  { k: 'Work while studying', f: pick('work') },
  { k: 'After you graduate', f: pick('post_study') },
].filter((r) => r.f);
const changing = facts.filter((f) => f.destination === d.slug && ['upcoming', 'not_current'].includes(presentation(f, today))).length;
---
<a class="visa" href={`/destinations/${d.slug}`}>
  <div class="visa-top">
    <div>
      <span class="visa-code" aria-hidden="true">{d.code}</span>
      <h3 class="visa-name">{d.name}</h3>
    </div>
    {changing > 0 && <span class="pill warn">{changing} changing</span>}
  </div>
  <div class="visa-body">
    <dl>
      {
        rows.map((r) => (
          <div>
            <dt>{r.k}</dt>
            <dd data-fact={r.f!.id} {...freshAttrs([r.f!])}>
              {r.f!.value} <ViewFlags />
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</a>
