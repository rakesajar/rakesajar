---
import type { Destination } from '../data/destinations';
import type { Fact } from '../data/types';
import { hostOf } from '../lib/domains';
import { appliesOn, formatDate, freshAttrs, presentation } from '../lib/facts';
import ViewFlags from './ViewFlags.astro';

interface Props {
  destination: Destination;
  facts: Fact[];
  today: string;
}
const { destination: d, facts, today } = Astro.props;
const current = (f: Fact) => f.destination === d.slug && appliesOn(f, today) && presentation(f, today) === 'current';
const permission = facts.find((f) => current(f) && f.topic === 'permission' && !f.stages);
const tuition = facts.filter((f) => current(f) && f.topic === 'tuition');
const changing = facts.filter((f) => f.destination === d.slug && ['upcoming', 'not_current'].includes(presentation(f, today))).length;
const lead = d.admissions[0];
---
<article class="visa">
  <div class="visa-top">
    <div>
      <span class="visa-code" aria-hidden="true" style={`view-transition-name: code-${d.slug}`}>{d.code}</span>
      <h3 class="visa-name">
        <a class="visa-link" href={`/destinations/${d.slug}`}>{d.name}</a>
      </h3>
    </div>
    {changing > 0 && <span class="pill warn">{changing} changing</span>}
  </div>
  <div class="visa-body">
    <dl>
      <div>
        <dt>Find courses</dt>
        <dd>
          <a class="visa-sub" href={lead.url} rel="noopener" target="_blank">{lead.short}</a>
          <span class="subtle small"> · {hostOf(lead.url)}</span>
        </dd>
      </div>
      {
        tuition.length > 0 ? (
          tuition.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd data-fact={f.id} {...freshAttrs([f])}>
                {f.value}
                <span class="cite"> · {hostOf(f.sources[0].url)} · {formatDate(f.verifiedAt)}</span> <ViewFlags />
              </dd>
            </div>
          ))
        ) : (
          <div>
            <dt>Tuition</dt>
            <dd class="muted">Varies by university. Check the course page.</dd>
          </div>
        )
      }
      {
        permission && (
          <div>
            <dt>You’d study on</dt>
            <dd data-fact={permission.id} {...freshAttrs([permission])}>
              {permission.value}
              <span class="cite"> · {hostOf(permission.sources[0].url)} · {formatDate(permission.verifiedAt)}</span> <ViewFlags />
            </dd>
          </div>
        )
      }
    </dl>
  </div>
</article>
