---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import type { Fact } from '../data/types';
import { hostOf } from '../lib/domains';
import { formatDate, presentation, STATUS_LABEL } from '../lib/facts';
import { formatMoney, HOME_CURRENCIES, upfrontEstimate } from '../lib/money';
import { FX_SOURCE_LABEL } from '../lib/fx';
import { BUILD_DATE, DESTINATIONS, FACTS, SIGNALS } from '../lib/store';

const today = BUILD_DATE;
const FREE_LIMIT = 2;
const DEFAULT = ['uk', 'canada'];

type Row = { key: string; label: string; pick: (slug: string) => Fact[] };
const of = (slug: string, topics: Fact['topic'][], opts: { includeNonCurrent?: boolean } = {}) =>
  FACTS.filter(
    (f) =>
      f.destination === slug &&
      topics.includes(f.topic) &&
      (presentation(f, today) === 'current' || (opts.includeNonCurrent && presentation(f, today) === 'not_current')),
  );
const rows: Row[] = [
  { key: 'permission', label: 'Study permission', pick: (s) => of(s, ['permission']) },
  { key: 'work', label: 'Work during studies', pick: (s) => of(s, ['work']) },
  { key: 'post', label: 'After graduation', pick: (s) => of(s, ['post_study']) },
  { key: 'fees', label: 'Visa and application fees', pick: (s) => of(s, ['fees'], { includeNonCurrent: true }) },
  { key: 'funds', label: 'Proof of funds', pick: (s) => of(s, ['funds'], { includeNonCurrent: true }) },
  { key: 'tuition', label: 'Tuition', pick: (s) => of(s, ['tuition']) },
];
const estimates = Object.fromEntries(DESTINATIONS.map((d) => [d.slug, upfrontEstimate(FACTS.filter((f) => f.destination === d.slug), d.currency, today)]));
const changing = (slug: string) =>
  FACTS.filter((f) => f.destination === slug && ['upcoming', 'not_current'].includes(presentation(f, today))).length +
  SIGNALS.filter((s) => s.destination === slug).length;
---
<Base
  title="Compare countries"
  description="Compare study destinations side by side: study permission, work rights, post-study options and official costs in your home currency, every figure cited."
>
  <PageHead
    eyebrow="Free tool"
    title="Compare countries"
    lede="Pick two countries. Each cell links to the official page it came from. The totals at the bottom only include government fees and proof-of-funds amounts; tuition depends on your offer, so add it in the cost planner."
  />

  <section class="section-tight">
    <div class="container">
      <form class="card grid" style="gap:20px" data-compare-form onsubmit="return false">
        <fieldset>
          <legend>Destinations <span class="hint">(up to {FREE_LIMIT} on the free plan)</span></legend>
          <div class="chip-group">
            {
              DESTINATIONS.map((d) => (
                <label class="chip">
                  <input type="checkbox" name="d" value={d.slug} checked={DEFAULT.includes(d.slug)} />
                  <span>
                    <span class="code-badge" style="width:1.9em;height:1.9em;font-size:0.65rem;border-radius:6px" aria-hidden="true">
                      {d.code}
                    </span>
                    {d.name}
                  </span>
                </label>
              ))
            }
          </div>
          <p class="small muted" data-limit-note style="margin:10px 0 0" aria-live="polite">
            <span class="lock">★ Premium</span> compares up to 4 countries at once. <a href="/plans">See plans</a>
          </p>
        </fieldset>
        <div class="grid grid-3" style="align-items:end">
          <div class="field">
            <label for="home">Show totals in</label>
            <select id="home" data-home>
              {HOME_CURRENCIES.map((c) => <option value={c} selected={c === 'INR'}>{c}</option>)}
            </select>
          </div>
          <div class="field" data-manual hidden>
            <span style="font-weight:600;font-size:0.92rem">Enter exchange rates</span>
            <div class="grid" style="gap:8px" data-manual-inputs></div>
          </div>
          <p class="small subtle" data-fx-status style="margin:0" aria-live="polite">Loading exchange rates…</p>
        </div>
      </form>

      <div class="table-wrap" style="margin-top:24px">
        <table data-compare-table>
          <caption class="visually-hidden">Comparison of selected destinations</caption>
          <thead>
            <tr>
              <th scope="col" style="width:180px">Topic</th>
              {
                DESTINATIONS.map((d) => (
                  <th scope="col" data-col={d.slug} hidden={!DEFAULT.includes(d.slug)}>
                    <a href={`/destinations/${d.slug}`}>{d.name}</a>
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              rows.map((r) => (
                <tr>
                  <th scope="row">{r.label}</th>
                  {DESTINATIONS.map((d) => {
                    const list = r.pick(d.slug);
                    return (
                      <td data-col={d.slug} hidden={!DEFAULT.includes(d.slug)}>
                        {list.length === 0 ? (
                          <span class="subtle small">No verified figure yet</span>
                        ) : (
                          <ul style="list-style:none;padding:0;margin:0;display:grid;gap:10px">
                            {list.map((f) => {
                              const p = presentation(f, today);
                              return (
                                <li>
                                  {list.length > 1 && <div class="small subtle">{f.label}</div>}
                                  <div style="font-weight:600" data-fact={f.id}>
                                    {p === 'not_current' ? <s>{f.value}</s> : f.value}
                                  </div>
                                  {p === 'not_current' && <span class={`pill ${f.status === 'proposed' ? 'warn' : 'bad'}`}>{STATUS_LABEL[f.status]}</span>}
                                  {f.estimate && <span class="pill gold">Indicative</span>}
                                  <div class="cite">
                                    <a href={f.sources[0].url} rel="noopener" target="_blank">
                                      {hostOf(f.sources[0].url)}
                                    </a>{' '}
                                    · {formatDate(f.verifiedAt)}
                                  </div>
                                </li>
                              );
                            })}
                          </ul>
                        )}
                      </td>
                    );
                  })}
                </tr>
              ))
            }
            <tr>
              <th scope="row">Changing or under review</th>
              {
                DESTINATIONS.map((d) => (
                  <td data-col={d.slug} hidden={!DEFAULT.includes(d.slug)}>
                    {changing(d.slug) ? (
                      <a class="pill warn" href={`/destinations/${d.slug}#checks`}>
                        {changing(d.slug)} item{changing(d.slug) > 1 ? 's' : ''}
                      </a>
                    ) : (
                      <span class="subtle small">None recorded</span>
                    )}
                  </td>
                ))
              }
            </tr>
            <tr class="total-row">
              <th scope="row">Official costs, first year<br /><span class="hint">Before tuition, local currency</span></th>
              {
                DESTINATIONS.map((d) => {
                  const e = estimates[d.slug];
                  return (
                    <td data-col={d.slug} hidden={!DEFAULT.includes(d.slug)}>
                      {e.lines.length ? (
                        <>
                          <div data-fact={e.lines.map((l) => l.factId).join(' ')} data-total={e.total} data-ccy={d.currency}>
                            {formatMoney(e.total, d.currency)}
                          </div>
                          <div class="cite">{[...new Set(e.lines.map((l) => l.label))].join(' + ')}</div>
                          {e.excluded.length > 0 && <div class="cite">Excludes: {e.excluded.map((x) => x.label).join(', ')}</div>}
                        </>
                      ) : (
                        <>
                          <span class="subtle small">Not enough verified figures</span>
                          {e.excluded.length > 0 && <div class="cite">Excludes: {e.excluded.map((x) => x.label).join(', ')}</div>}
                        </>
                      )}
                    </td>
                  );
                })
              }
            </tr>
            <tr class="total-row">
              <th scope="row">In your currency</th>
              {
                DESTINATIONS.map((d) => (
                  <td data-col={d.slug} hidden={!DEFAULT.includes(d.slug)}>
                    <span data-converted={d.slug} data-fact={estimates[d.slug].lines.map((l) => l.factId).join(' ') || 'none'}>—</span>
                  </td>
                ))
              }
            </tr>
          </tbody>
        </table>
      </div>
      <p class="small muted" style="margin-top:12px">
        Monthly funds figures are multiplied by 12 as a planning assumption. Official requirement periods vary, so check the
        official page. Exchange rates: <span data-fx-label>{FX_SOURCE_LABEL}</span>.
      </p>
    </div>
  </section>

  <script>
    import { convert, formatMoney, type EurRates } from '../lib/money';
    import { fetchFx, FX_SOURCE_LABEL } from '../lib/fx';

    const FREE_LIMIT = 2;
    const form = document.querySelector<HTMLFormElement>('[data-compare-form]')!;
    const boxes = [...form.querySelectorAll<HTMLInputElement>('input[name="d"]')];
    const home = form.querySelector<HTMLSelectElement>('[data-home]')!;
    const status = form.querySelector<HTMLElement>('[data-fx-status]')!;
    const manual = form.querySelector<HTMLElement>('[data-manual]')!;
    const manualInputs = form.querySelector<HTMLElement>('[data-manual-inputs]')!;
    /** User-entered rates: units of home currency per 1 unit of the local currency. */
    const manualRates: Record<string, number> = {};
    let rates: EurRates = {};

    // Restore a shared selection from the URL (?d=uk,canada).
    const fromUrl = new URLSearchParams(location.search).get('d')?.split(',').filter(Boolean) ?? [];
    if (fromUrl.length) boxes.forEach((b) => (b.checked = fromUrl.slice(0, FREE_LIMIT).includes(b.value)));

    function selected(): string[] {
      return boxes.filter((b) => b.checked).map((b) => b.value);
    }

    function applySelection(): void {
      const sel = selected();
      boxes.forEach((b) => (b.disabled = !b.checked && sel.length >= FREE_LIMIT));
      document.querySelectorAll<HTMLElement>('[data-compare-table] [data-col]').forEach((cell) => {
        cell.hidden = !sel.includes(cell.dataset.col!);
      });
      const url = new URL(location.href);
      if (sel.length) url.searchParams.set('d', sel.join(','));
      else url.searchParams.delete('d');
      history.replaceState(null, '', url);
      renderTotals();
    }

    function manualField(from: string, to: string): HTMLElement {
      const id = `rate-${from}`;
      const wrap = document.createElement('div');
      wrap.className = 'field';
      const label = document.createElement('label');
      label.htmlFor = id;
      label.textContent = `1 ${from} = ? ${to}`;
      const input = document.createElement('input');
      Object.assign(input, { id, type: 'number', min: '0', step: 'any', inputMode: 'decimal' });
      if (manualRates[from + to]) input.value = String(manualRates[from + to]);
      input.addEventListener('input', () => {
        manualRates[from + to] = Number(input.value);
        renderTotals(false);
      });
      wrap.append(label, input);
      return wrap;
    }

    function renderTotals(rebuildInputs = true): void {
      const to = home.value;
      const missing = new Set<string>();
      document.querySelectorAll<HTMLElement>('[data-total]').forEach((el) => {
        const cell = el.closest<HTMLElement>('[data-col]')!;
        const out = document.querySelector<HTMLElement>(`[data-converted="${cell.dataset.col}"]`)!;
        const from = el.dataset.ccy!;
        const amount = Number(el.dataset.total);
        const manualRate = manualRates[from + to];
        const value = convert(amount, from, to, rates) ?? (manualRate > 0 ? amount * manualRate : null);
        if (value === null) {
          out.textContent = 'Rate needed';
          if (!cell.hidden) missing.add(from);
        } else out.textContent = '≈ ' + formatMoney(value, to);
      });
      if (rebuildInputs) {
        manualInputs.replaceChildren(...[...missing].map((from) => manualField(from, to)));
        manual.hidden = missing.size === 0;
      }
    }

    boxes.forEach((b) => b.addEventListener('change', applySelection));
    home.addEventListener('change', () => renderTotals());
    applySelection();

    fetchFx().then((fx) => {
      if (fx) {
        rates = fx.rates;
        status.textContent = `${FX_SOURCE_LABEL}, ${fx.date}. Indicative only.`;
      } else {
        status.textContent = 'Live rates unavailable. Enter a rate to see totals in your currency.';
      }
      renderTotals();
    });
  </script>
</Base>
