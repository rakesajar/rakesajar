---
import Base from '../layouts/Base.astro';
import DestCard from '../components/DestCard.astro';
import FactRow from '../components/FactRow.astro';
import ViewFlags from '../components/ViewFlags.astro';
import type { Fact, Stage } from '../data/types';
import { BUILD_DATE, CHANGES, DESTINATIONS, FACTS, SIGNALS, DESTINATION_BY_SLUG } from '../lib/store';
import { factById, formatDate, freshAttrs, presentation } from '../lib/facts';
import { hostOf } from '../lib/domains';

const today = BUILD_DATE;
const example = factById(FACTS, 'fr-fee-master');
const recent = CHANGES.filter((c) => c.destination !== 'all').slice(0, 3);
const KIND: Record<string, { pill: string; label: string }> = {
  announced: { pill: 'info', label: 'Announced' },
  litigated: { pill: 'bad', label: 'In court' },
  proposed: { pill: 'warn', label: 'Proposed' },
  quarantined: { pill: 'bad', label: 'Re-checking' },
  reported: { pill: 'plain', label: 'Reported' },
  published: { pill: 'ok', label: 'Published' },
};
const board = DESTINATIONS.map((d) => {
  const facts = FACTS.filter((f) => f.destination === d.slug);
  const changing =
    facts.filter((f) => ['upcoming', 'not_current'].includes(presentation(f, today))).length +
    SIGNALS.filter((s) => s.destination === d.slug).length;
  return { d, changing };
});

// Facts that differ by level of study, grouped for the "where are you now" panels.
const byStage = (stage: Stage): Fact[] =>
  FACTS.filter((f) => f.stages?.includes(stage) && ['current', 'upcoming'].includes(presentation(f, today)));
const ug = byStage('ug');
const pg = FACTS.filter(
  (f) =>
    (f.stages?.includes('pg') || f.stages?.includes('phd')) &&
    !f.stages?.includes('ug') &&
    ['current', 'upcoming'].includes(presentation(f, today)),
);
const tuitionFacts = FACTS.filter((f) => f.topic === 'tuition' && presentation(f, today) === 'current');
---

<Base
  title="Pathfinder"
  description="Choosing where to study abroad after Class 12 or your bachelor's: compare 11 countries on how to apply, tuition, what you'd study on and the official costs, each linked to its official source."
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Pathfinder',
    description: 'Choosing where to study abroad, checked against official sources.',
  }}
>
  <section class="hero">
    <div class="container grid grid-2" style="align-items:center;gap:clamp(32px,5vw,64px)">
      <div>
        <p class="eyebrow">University admissions abroad · 11 countries</p>
        <h1>Choosing where to apply is the biggest decision. Make it on the official facts.</h1>
        <p class="lede">
          For students finishing Class 12 or a bachelor’s, and the parents helping them decide. See where each country’s courses
          are listed, what tuition looks like, what you’d study on and what the government expects you to show, all linked to the
          official pages.
        </p>
        <div class="row" style="margin-top:28px">
          <a class="btn btn-primary" href="#where-are-you">Start from where you are</a>
          <a class="btn btn-secondary" href="/compare">Compare two countries</a>
        </div>
        <p class="small muted" style="margin-top:24px;max-width:52ch">
          No university pays us, and no agent earns from your choice. We don’t rank universities and we never will.
        </p>
      </div>

      <div class="board" role="region" aria-label="Destinations board">
        <div class="board-head">
          <span class="board-title">Departures</span>
          <span>As of {formatDate(today)}</span>
        </div>
        <div style="overflow-x:auto">
          <table>
            <caption class="visually-hidden">Destinations, where to find courses, and whether rules are changing</caption>
            <thead>
              <tr>
                <th scope="col">Code</th>
                <th scope="col">Destination</th>
                <th scope="col" class="col-wide">Find courses via</th>
                <th scope="col">Remarks</th>
              </tr>
            </thead>
            <tbody>
              {
                board.map(({ d, changing }, i) => (
                  <tr>
                    <td>
                      <span class="flap" style={`--i:${i}`}>
                        {d.code}
                      </span>
                    </td>
                    <td>
                      <a href={`/destinations/${d.slug}`}>{d.name}</a>
                    </td>
                    <td class="col-wide">{d.admissions[0].short}</td>
                    <td class={changing ? 'status-changing' : 'status-settled'}>{changing ? 'Changing' : 'No changes'}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="where-are-you" style="padding-top:0">
    <div class="container">
      <p class="eyebrow">Where are you right now?</p>
      <h2 style="max-width:24ch">The same country can look very different depending on what you’re applying for</h2>
      <div class="doors">
        <fieldset class="door-tabs">
        <legend class="visually-hidden">Choose what describes you</legend>
        <input type="radio" name="door" id="door-ug" value="ug" checked />
        <label for="door-ug" class="door">
          <span class="door-kicker">I’m in or finishing</span>
          <span class="door-title">Class 12</span>
        </label>
        <input type="radio" name="door" id="door-pg" value="pg" />
        <label for="door-pg" class="door">
          <span class="door-kicker">I’ve done or am finishing</span>
          <span class="door-title">A bachelor’s</span>
        </label>
        <input type="radio" name="door" id="door-parent" value="parent" />
        <label for="door-parent" class="door">
          <span class="door-kicker">I’m helping as a</span>
          <span class="door-title">Parent or guardian</span>
        </label>
        </fieldset>

        <div class="door-panel" data-door="ug">
          <div class="grid grid-2" style="gap:32px;align-items:start">
            <div>
              <h3>Applying for an undergraduate degree</h3>
              <p class="muted">
                Most of what you’ll compare is the course itself: where it’s listed, what it costs, and what you’ll be allowed to
                do once you graduate. Entry requirements are set by each university, so the university’s own course page is the
                final word.
              </p>
              <ul class="check-list small">
                <li>Shortlist countries first, then courses. The official course listings are on each country card below.</li>
                <li>Read the university’s entry requirements for applicants with your board (CBSE, ICSE, state board or other).</li>
                <li>Note what happens after the degree. It changes for some countries depending on when you apply.</li>
              </ul>
            </div>
            <div>
              <p class="small subtle mono" style="margin:0 0 8px">Rules that apply to undergraduates</p>
              <ul class="stage-facts">
                {
                  ug.map((f) => (
                    <li data-fact={f.id} {...freshAttrs([f])}>
                      <span class="stage-country mono">{DESTINATION_BY_SLUG[f.destination].code}</span>
                      <span>
                        <strong>{f.label}:</strong> {f.value}
                        <span class="cite">
                          {' '}
                          · <a href={f.sources[0].url} rel="noopener" target="_blank">{hostOf(f.sources[0].url)}</a> · {formatDate(f.verifiedAt)}
                        </span>
                        <ViewFlags />
                      </span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>

        <div class="door-panel" data-door="pg">
          <div class="grid grid-2" style="gap:32px;align-items:start">
            <div>
              <h3>Applying for a master’s or PhD</h3>
              <p class="muted">
                Each university sets its own entry rules for postgraduate courses, and a few visa rules treat master’s and PhD
                students differently from undergraduates. Those differences are listed here so they don’t surprise you later.
              </p>
              <ul class="check-list small">
                <li>Check whether your degree is recognised for entry: the university’s admissions page will say.</li>
                <li>For a PhD, find the supervisor or research group before you apply.</li>
                <li>Compare what each country allows after a postgraduate or research degree.</li>
              </ul>
            </div>
            <div>
              <p class="small subtle mono" style="margin:0 0 8px">Rules specific to master’s and PhD</p>
              <ul class="stage-facts">
                {
                  pg.map((f) => (
                    <li data-fact={f.id} {...freshAttrs([f])}>
                      <span class="stage-country mono">{DESTINATION_BY_SLUG[f.destination].code}</span>
                      <span>
                        <strong>{f.label}:</strong> {f.value}
                        <span class="cite">
                          {' '}
                          · <a href={f.sources[0].url} rel="noopener" target="_blank">{hostOf(f.sources[0].url)}</a> · {formatDate(f.verifiedAt)}
                        </span>
                        <ViewFlags />
                      </span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>

        <div class="door-panel" data-door="parent">
          <div class="grid grid-2" style="gap:32px;align-items:start">
            <div>
              <h3>If you’re the one paying</h3>
              <p class="muted">
                Every country page separates the amounts set by the government, like visa fees and proof of funds, from the
                amounts only the university can tell you, like tuition. Those two are easy to mix up, and not everyone who
                advises you will make the difference clear.
              </p>
              <ul class="check-list small">
                <li>Use the cost planner with the tuition on the offer letter to see the first year in rupees.</li>
                <li>Before any money leaves your account, check the amount on the official page we link to.</li>
                <li>Pay only on official university or government websites. We list the official domains on every country page.</li>
              </ul>
              <a class="btn btn-secondary" href="/cost-planner">Open the cost planner</a>
            </div>
            <div>
              <p class="small subtle mono" style="margin:0 0 8px">Tuition figures we’ve verified so far</p>
              <ul class="stage-facts">
                {
                  tuitionFacts.map((f) => (
                    <li data-fact={f.id} {...freshAttrs([f])}>
                      <span class="stage-country mono">{DESTINATION_BY_SLUG[f.destination].code}</span>
                      <span>
                        <strong>{f.label}:</strong> {f.value}
                        <span class="cite">
                          {' '}
                          · <a href={f.sources[0].url} rel="noopener" target="_blank">{hostOf(f.sources[0].url)}</a> · {formatDate(f.verifiedAt)}
                        </span>
                        <ViewFlags />
                      </span>
                    </li>
                  ))
                }
              </ul>
              <p class="small muted">For other countries, tuition is set by each university. It will be on the course page and your offer letter.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container">
      <p class="eyebrow">Destinations</p>
      <div class="row" style="justify-content:space-between;align-items:end;margin-bottom:28px">
        <h2 style="margin:0;max-width:22ch">Start with the country you keep coming back to</h2>
        <a class="btn btn-ghost" href="/destinations">All destinations</a>
      </div>
      <div class="grid grid-3 cards">
        {DESTINATIONS.map((d) => <DestCard destination={d} facts={FACTS} today={today} />)}
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--surface-2);border-block:1px dashed var(--line-strong)">
    <div class="container">
      <p class="eyebrow">The admissions road</p>
      <h2 style="max-width:26ch">From “maybe abroad” to a seat on the plane, in the order it happens</h2>
      <ol class="road">
        <li>
          <span class="road-step mono">Shortlist</span>
          <h3>Pick two or three countries</h3>
          <p class="small muted">Compare how you’d apply, tuition, and what you can do after the degree.</p>
          <a class="small" href="/compare">Compare countries</a>
        </li>
        <li>
          <span class="road-step mono">Research</span>
          <h3>Find courses and entry requirements</h3>
          <p class="small muted">Use the official course listings on each country page, then the university’s own page.</p>
          <a class="small" href="/destinations">Country pages</a>
        </li>
        <li>
          <span class="road-step mono">Apply</span>
          <h3>Send applications and track deadlines</h3>
          <p class="small muted">Deadlines are set by each university. Premium will keep them in one tracker.</p>
          <a class="small" href="/plans">About Premium</a>
        </li>
        <li>
          <span class="road-step mono">Offer</span>
          <h3>Accept an offer and plan the money</h3>
          <p class="small muted">Add your tuition to the official fees and proof-of-funds amounts.</p>
          <a class="small" href="/cost-planner">Cost planner</a>
        </li>
        <li>
          <span class="road-step mono">Visa</span>
          <h3>Apply for your student visa</h3>
          <p class="small muted">Each country page lists the steps and the official pages to apply on.</p>
          <a class="small" href="/destinations/uk#steps">See an example</a>
        </li>
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container anatomy">
      <div>
        <p class="eyebrow">How to read this site</p>
        <h2>Every number comes with its paperwork</h2>
        <p class="muted" style="margin-bottom:24px">This is a real entry from the France page. Each part is there so you can check it yourself.</p>
        <div class="facts" style="box-shadow:var(--shadow)">
          <FactRow fact={example} today={today} anchor={false} />
        </div>
      </div>
      <ol class="anatomy-notes">
        <li><span><strong>The figure</strong>, worded as closely as we can to the official page.</span></li>
        <li>
          <span>
            <strong>The stamp.</strong> Green is in force, blue is announced with a start date, amber and red mean proposed, in
            court or being re-checked. Those are never shown as today’s rule.
          </span>
        </li>
        <li>
          <span><strong>The source.</strong> T1 is a government. T2 is a university or official register. Click through to the page we used.</span>
        </li>
        <li>
          <span><strong>The date we checked.</strong> When it gets old, the entry says “re-check due” instead of hoping nobody notices.</span>
        </li>
      </ol>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container grid grid-2" style="gap:clamp(32px,5vw,64px);align-items:start">
      <div>
        <p class="eyebrow">Notice board</p>
        <h2>Changes that could affect this year’s applicants</h2>
        <p class="aside-note">
          Applying to the UK? What you can do after graduating depends on when you apply for the Graduate Route, before or after 1
          January 2027.
        </p>
        <a class="btn btn-secondary" href="/changes">Read the full change log</a>
      </div>
      <ol style="list-style:none;padding:0;margin:0">
        {
          recent.map((c) => (
            <li class="notice">
              <div class="row" style="margin-bottom:8px">
                <span class={`pill ${KIND[c.kind].pill}`}>{KIND[c.kind].label}</span>
                <span class="small subtle mono">
                  {c.destination !== 'all' && DESTINATION_BY_SLUG[c.destination].code} · {formatDate(c.date)}
                </span>
              </div>
              <a href={`/destinations/${c.destination}#checks`} style="font-weight:600;color:var(--ink)">
                {c.title}
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="panel grid grid-2" style="gap:32px;align-items:center">
        <div>
          <p class="eyebrow">Things we won’t do</p>
          <h2 style="font-size:1.6rem">We’re here to help you choose, not to choose for you</h2>
        </div>
        <ul class="check-list x-list">
          <li>Take a commission from a university, agent or lender</li>
          <li>Rank universities or tell you your chances of admission</li>
          <li>Write your statement of purpose for you (we’ll give feedback on yours)</li>
          <li>Fill in or submit applications, or ask for your portal passwords</li>
          <li>Quote a rule, fee or deadline we haven’t checked against an official page</li>
        </ul>
      </div>
    </div>
  </section>
</Base>
