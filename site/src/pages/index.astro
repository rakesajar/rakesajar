---
import Base from '../layouts/Base.astro';
import DestCard from '../components/DestCard.astro';
import FactRow from '../components/FactRow.astro';
import { BUILD_DATE, CHANGES, DESTINATIONS, FACTS, DESTINATION_BY_SLUG } from '../lib/store';
import { factById, formatDate } from '../lib/facts';
import { hostOf } from '../lib/domains';

const today = BUILD_DATE;
const sourceHosts = new Set(FACTS.flatMap((f) => f.sources.map((s) => hostOf(s.url))));
const example = [factById(FACTS, 'uk-graduate-2y'), factById(FACTS, 'uk-graduate-18m')];
const recent = CHANGES.filter((c) => c.destination !== 'all').slice(0, 4);
const kindPill: Record<string, string> = {
  announced: 'info',
  litigated: 'bad',
  proposed: 'warn',
  quarantined: 'bad',
  reported: 'plain',
  published: 'ok',
};
---
<Base
  title="Pathfinder"
  description="Compare study-abroad destinations on facts cited to official government sources, with the date each fact was last verified. No commissions."
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Pathfinder',
    description: 'Verified study-abroad guides for 11 destinations.',
  }}
>
  <section class="hero">
    <div class="container grid grid-2" style="align-items:center;gap:clamp(32px,5vw,64px)">
      <div>
        <p class="eyebrow">Study abroad, verified</p>
        <h1>Plan your degree abroad on facts you can check.</h1>
        <p class="lede">
          Visas, work rights, post-study options and official costs for 11 countries. Every figure links to the government or
          official source it came from and shows the date we last checked it.
        </p>
        <div class="row" style="margin-top:28px">
          <a class="btn btn-primary" href="/destinations">Explore destinations</a>
          <a class="btn btn-secondary" href="/compare">Compare countries</a>
        </div>
        <ul class="check-list small muted" style="margin-top:28px">
          <li>Only government and official sources. Never forums, agents or blogs.</li>
          <li>Rules that are proposed, in court or disputed are labelled. We never present them as current.</li>
          <li>No commissions and no paid placements, from anyone.</li>
        </ul>
      </div>
      <div class="card" style="box-shadow:var(--shadow-lg);padding:0;overflow:hidden">
        <div style="padding:18px 20px;border-bottom:1px solid var(--line)" class="row">
          <span class="code-badge" aria-hidden="true">GB</span>
          <div>
            <div style="font-weight:650">United Kingdom · Graduate Route</div>
            <div class="small subtle">This is how every fact appears on Pathfinder</div>
          </div>
        </div>
        <div class="facts" style="border:0;border-radius:0">
          {example.map((f) => <FactRow fact={f} today={today} />)}
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight" aria-label="At a glance" style="border-block:1px solid var(--line);background:var(--surface)">
    <div class="container grid grid-4">
      <div class="stat"><span class="stat-num">{DESTINATIONS.length}</span><span class="muted small">destinations, all live</span></div>
      <div class="stat"><span class="stat-num">{FACTS.length}</span><span class="muted small">facts, each with a source and date</span></div>
      <div class="stat">
        <span class="stat-num">{sourceHosts.size}</span><span class="muted small">official domains cited</span>
      </div>
      <div class="stat"><span class="stat-num">0</span><span class="muted small">commissions or paid placements</span></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="row" style="justify-content:space-between;align-items:end;margin-bottom:28px">
        <div>
          <p class="eyebrow">Destinations</p>
          <h2 style="margin:0">Eleven countries, one standard of evidence</h2>
        </div>
        <a class="btn btn-ghost" href="/destinations">All destinations →</a>
      </div>
      <div class="grid grid-3">
        {DESTINATIONS.map((d) => <DestCard destination={d} facts={FACTS} today={today} />)}
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--surface-2)">
    <div class="container grid grid-2" style="gap:clamp(32px,5vw,64px)">
      <div>
        <p class="eyebrow">What’s changing</p>
        <h2>Rules change. We tell you when, and what it means.</h2>
        <p class="muted">
          Announced changes appear with their start date. Proposals and rules being challenged in court are labelled, so you
          never plan around something that isn’t in force.
        </p>
        <a class="btn btn-secondary" href="/changes">See all changes</a>
      </div>
      <ol class="timeline" style="list-style:none;padding:0;margin:0">
        {
          recent.map((c) => (
            <li class="card">
              <div class="row" style="margin-bottom:6px">
                <span class={`pill ${kindPill[c.kind]}`}>{c.kind[0].toUpperCase() + c.kind.slice(1)}</span>
                <span class="small subtle">
                  {c.destination !== 'all' && DESTINATION_BY_SLUG[c.destination].name} · logged {formatDate(c.date)}
                </span>
              </div>
              <div style="font-weight:600">{c.title}</div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">How it works</p>
      <h2>Built so you don’t have to take our word for it</h2>
      <div class="grid grid-3" style="margin-top:28px">
        <div class="card">
          <h3>1 · Official sources only</h3>
          <p class="muted small">
            We read government, regulator and university websites from a published allowlist. Everything else, including
            forums, agents, blogs and social media, is blocked.
          </p>
        </div>
        <div class="card">
          <h3>2 · Checked automatically</h3>
          <p class="muted small">
            Visa rules and fees must come from a government source. If two official sources disagree, the fact is quarantined
            and re-checked until they agree.
          </p>
        </div>
        <div class="card">
          <h3>3 · Shown with its evidence</h3>
          <p class="muted small">
            Each fact shows its source, status and verification date. Once a fact passes its freshness limit, we mark it
            “re-check due” until it is verified again.
          </p>
        </div>
      </div>
      <p style="margin-top:20px"><a href="/how-we-verify">Read our full verification method →</a></p>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container grid grid-3">
      <a class="card card-link" href="/compare">
        <p class="eyebrow">Free</p>
        <h3>Compare countries</h3>
        <p class="muted small">
          Put two destinations side by side, with work rights, post-study options and official costs converted to your home
          currency.
        </p>
      </a>
      <a class="card card-link" href="/cost-planner">
        <p class="eyebrow">Free</p>
        <h3>Cost planner</h3>
        <p class="muted small">
          Add your tuition from your offer letter to the official fees and proof-of-funds figures to see your first-year
          budget.
        </p>
      </a>
      <a class="card card-link" href="/ask">
        <p class="eyebrow">Preview · 3 free questions a day</p>
        <h3>Ask Pathfinder</h3>
        <p class="muted small">
          Ask in plain English. Answers come only from verified facts, with a citation on each one. If we can’t verify it, we
          say so.
        </p>
      </a>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="panel grid grid-2" style="align-items:center;gap:32px">
        <div>
          <h2>What we will never do</h2>
          <p class="muted">Independence is the product. These lines don’t move.</p>
        </div>
        <ul class="check-list x-list">
          <li>Take commissions from universities, agents or lenders</li>
          <li>Predict or guarantee admission or visa outcomes</li>
          <li>Write your essays for you (we give feedback only)</li>
          <li>Submit forms, pay fees or store your portal passwords</li>
          <li>Answer rules, fees or deadlines from memory</li>
        </ul>
      </div>
    </div>
  </section>
</Base>
