---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import DestCard from '../../components/DestCard.astro';
import { BUILD_DATE, DESTINATIONS, FACTS } from '../../lib/store';
---
<Base
  title="Destinations"
  description="Verified study guides for Singapore, the USA, UK, Canada, Australia, Germany, France, Ireland, New Zealand, the UAE and Japan."
>
  <PageHead
    eyebrow="Free guides"
    title="Destinations"
    lede="Each guide has the same eight sections in the same order, so once you’ve read one you know where to look in the others."
  />
  <section class="section-tight">
    <div class="container">
      <div class="grid grid-3">
        {DESTINATIONS.map((d) => <DestCard destination={d} facts={FACTS} today={BUILD_DATE} />)}
      </div>
      <p class="small muted" style="margin-top:24px">
        Not sure where to start? <a href="/compare">Compare two countries side by side</a> or <a href="/ask">ask a question</a>.
      </p>
    </div>
  </section>
</Base>
