---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page doesn't exist.">
  <section class="section">
    <div class="container prose">
      <p class="eyebrow">404</p>
      <h1>We couldn’t find that page</h1>
      <p class="lede">It may have moved. These are good places to start:</p>
      <div class="row">
        <a class="btn btn-primary" href="/destinations">Destinations</a>
        <a class="btn btn-secondary" href="/compare">Compare countries</a>
        <a class="btn btn-secondary" href="/">Home</a>
      </div>
    </div>
  </section>
</Base>
