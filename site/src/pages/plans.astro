---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { DESTINATIONS } from '../lib/store';

type Cell = boolean | string;
const features: [string, Cell, Cell, Cell][] = [
  ['11 verified destination guides', true, true, true],
  ['Country comparison', '2 countries', '2 countries, saved', '4 countries, saved'],
  ['Cost planner with live exchange rates', true, 'Saved', true],
  ['Ask Pathfinder (cited answers)', '3 a day', '10 a day', 'Unlimited (fair use)'],
  ['Personal shortlist', false, '1 country', 'All countries'],
  ['Deadline tracker and reminders', false, '1 country', 'All countries'],
  ['Document vault and checklists', false, false, true],
  ['Field-by-field form guidance', false, false, true],
  ['Essay and SOP feedback', false, false, true],
  ['Policy-change alerts', 'Weekly digest', true, 'Real-time'],
];
const gates = [
  'We test its answers against the official pages, question by question',
  'Every number in an answer has to point to the page it came from',
  'It must decline, every time, when a rule is proposed, disputed or in court',
  'A lawyer in that country confirms the guidance is allowed there',
];
---
<Base
  title="Plans"
  description="Pathfinder plans: free verified guides and tools, with Premium adding a personal concierge, shortlists, deadlines, documents and form guidance."
>
  <PageHead
    eyebrow="Plans"
    title="Plans"
    lede="The country guides, the comparison and the cost planner are free during the pilot. Premium is for the months when you are actually applying and need help keeping track."
  />
  <section class="section-tight">
    <div class="container">
      <div class="grid grid-3">
        <div class="card">
          <p class="eyebrow">Free</p>
          <h2 style="font-size:1.5rem">Looking around</h2>
          <p class="muted small">Every guide, comparison of two countries, the cost planner and three questions a day.</p>
          <a class="btn btn-primary" href="/destinations">Read the country guides</a>
        </div>
        <div class="card">
          <p class="eyebrow">Free account</p>
          <h2 style="font-size:1.5rem">Narrowing down</h2>
          <p class="muted small">Save comparisons and costs, ask ten questions a day, and track one country.</p>
          <span class="pill plain">Accounts open soon</span>
        </div>
        <div class="card" style="border-color:var(--gold);box-shadow:var(--shadow)">
          <p class="eyebrow" style="color:var(--gold)">Premium · per application cycle</p>
          <h2 style="font-size:1.5rem">Application season</h2>
          <p class="muted small">
            An assistant that searches official websites for you, plus your shortlist, deadlines, document checklist, form guidance
            and feedback on your essays, for every country you apply to.
          </p>
          <span class="pill gold">Opening country by country</span>
        </div>
      </div>

      <h2 style="margin-top:56px">Compare plans</h2>
      <div class="table-wrap">
        <table>
          <caption class="visually-hidden">Features by plan</caption>
          <thead><tr><th scope="col">Feature</th><th scope="col">Free</th><th scope="col">Free account</th><th scope="col">Premium</th></tr></thead>
          <tbody>
            {
              features.map(([name, ...cells]) => (
                <tr>
                  <th scope="row" style="white-space:normal">{name}</th>
                  {cells.map((c) => (
                    <td>{c === true ? <span aria-label="Included">✓</span> : c === false ? <span class="subtle small">Not included</span> : c}</td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="small muted" style="margin-top:12px">Pricing will be announced at launch and adjusted by region.</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container grid grid-2" style="gap:32px;align-items:start">
      <div>
        <p class="eyebrow">Before Premium opens</p>
        <h2>Premium opens one country at a time</h2>
        <p class="muted">We switch Premium on for a country only after its answers pass these tests, and we switch it back off if they stop passing. While it’s off, you get links to the official pages instead of answers.</p>
        <ul class="check-list" data-figure-ok="policy">{gates.map((g) => <li>{g}</li>)}</ul>
      </div>
      <div class="table-wrap">
        <table>
          <caption class="visually-hidden">Premium status by destination</caption>
          <thead><tr><th scope="col">Destination</th><th scope="col">Country guide</th><th scope="col">Premium</th></tr></thead>
          <tbody>
            {
              DESTINATIONS.map((d) => (
                <tr>
                  <th scope="row">{d.name}</th>
                  <td><span class="pill ok">Free</span></td>
                  <td><span class="pill plain">Not open yet</span></td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>
</Base>
